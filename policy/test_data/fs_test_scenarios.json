      {
        "name": "deny_sensitive_file_access",
        "input": {
          "operation": "read",
          "user_id": "user123",
          "path": "/etc/shadow",
          "timestamp": "2024-01-15T14:00:00Z"
        },
        "data": {
          "users": {
            "user123": {
              "role": "developer",
              "tier": "premium",
              "groups": ["developers"],
              "additional_scopes": [
                {"type": "directory", "path": "/home/user123"}
