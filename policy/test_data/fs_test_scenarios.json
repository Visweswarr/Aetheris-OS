              "access_restrictions": {
                "restricted_hours": [0, 1, 2, 3, 4, 5]
              }
            }
          },
          "policy_config": {
            "role_scopes": {
              "developer": [
                {"type": "directory", "path": "/workspace"},
                {"type": "directory", "path": "/opt/dev"},
                {"type": "directory", "path": "/etc"}
              ]
            },
            "role_permissions": {
              "developer": {
                "allowed_operations": ["read", "write", "execute", "list", "stat"]
              }
            },
            "sensitive_file_patterns": [
              "/etc/passwd",
              "/etc/shadow",
              "/etc/ssh/*",
              "*.key",
              "*.pem"
            ],
            "user_limits": {
              "premium": {
                "max_file_size": 1073741824,
                "disk_quota": 107374182400
              }
            }
          },
          "file_usage": {
            "user123": [
              {"path": "/home/user123/project1", "size": 1048576}
            ]
          }
        },
        "expected": {
          "allow": false,
          "rationale_contains": ["sensitive file"]
        }
