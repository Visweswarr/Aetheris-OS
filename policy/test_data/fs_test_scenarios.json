{
  "test_scenarios": {
    "fs_access_scopes": [
      {
        "name": "allow_user_home_directory_read",
        "input": {
          "operation": "read",
          "user_id": "user123",
          "path": "/home/user123/document.txt",
          "timestamp": "2024-01-15T14:00:00Z"
        },
        "data": {
          "users": {
            "user123": {
              "role": "developer",
              "tier": "premium",
              "groups": ["developers", "beta_testers"],
              "additional_scopes": [
                {"type": "directory", "path": "/home/user123"}
              ],
              "access_restrictions": {
                "restricted_hours": [0, 1, 2, 3, 4, 5]
              }
            }
          },
          "policy_config": {
            "role_scopes": {
              "developer": [
                {"type": "directory", "path": "/workspace"},
                {"type": "directory", "path": "/opt/dev"}
              ]
            },
            "role_permissions": {
              "developer": {
                "allowed_operations": ["read", "write", "execute", "list", "stat"]
              }
            },
            "user_limits": {
              "premium": {
                "max_file_size": 1073741824,
                "disk_quota": 107374182400
              }
            }
          },
          "file_usage": {
            "user123": [
              {"path": "/home/user123/project1", "size": 1048576}
            ]
          }
        },
        "expected": {
          "allow": true,
          "rationale_contains": ["filesystem access approved", "operation: read"]
        }
      },
