# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Rust files
[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

# Go files
[*.go]
indent_style = tab
indent_size = 4
max_line_length = 120

# Python files
[*.py]
indent_style = space
indent_size = 4
max_line_length = 88

# TypeScript/JavaScript files
[*.{ts,js,tsx,jsx}]
indent_style = space
indent_size = 2
max_line_length = 100

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
indent_style = space
indent_size = 2
max_line_length = 80
trim_trailing_whitespace = false

# Shell scripts (force LF)
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# PowerShell scripts (allow CRLF on Windows)
[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

# Makefile (tabs required)
[Makefile]
indent_style = tab
indent_size = 4

# C/C++ files
[*.{c,cpp,h,hpp}]
indent_style = space
indent_size = 4
max_line_length = 100

# Header files
[*.h]
indent_style = space
indent_size = 4

# Assembly files
[*.{s,S,asm}]
indent_style = space
indent_size = 4

# Configuration files
[*.{toml,ini,cfg}]
indent_style = space
indent_size = 2

# Docker files
[Dockerfile*]
indent_style = space
indent_size = 2

# Git files
[.gitignore]
indent_style = space
indent_size = 2

# CI/CD files
[.github/**/*.yml]
indent_style = space
indent_size = 2

[.github/**/*.yaml]
indent_style = space
indent_size = 2

# Package files
[package.json]
indent_style = space
indent_size = 2

[package-lock.json]
indent_style = space
indent_size = 2

[Cargo.toml]
indent_style = space
indent_size = 4

[go.mod]
indent_style = tab
indent_size = 4

[go.sum]
indent_style = tab
indent_size = 4

# Requirements files
[requirements*.txt]
indent_style = space
indent_size = 2

# CMake files
[CMakeLists.txt]
indent_style = space
indent_size = 2

[*.cmake]
indent_style = space
indent_size = 2

# XML files
[*.xml]
indent_style = space
indent_size = 2

# HTML files
[*.html]
indent_style = space
indent_size = 2

# CSS files
[*.css]
indent_style = space
indent_size = 2

# SCSS files
[*.scss]
indent_style = space
indent_size = 2

# SQL files
[*.sql]
indent_style = space
indent_size = 2

# Protocol buffer files
[*.proto]
indent_style = space
indent_size = 2

# CDDL files
[*.cddl]
indent_style = space
indent_size = 2

# License files
[LICENSE*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# README files
[README*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# CHANGELOG files
[CHANGELOG*]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Binary files (no changes)
[*.{png,jpg,jpeg,gif,ico,svg,pdf,zip,tar,gz,bz2,xz,7z,rar}]
insert_final_newline = false
trim_trailing_whitespace = false

# WebAssembly files
[*.wasm]
insert_final_newline = false
trim_trailing_whitespace = false

# Executable files
[*.{exe,bin,so,dylib,dll}]
insert_final_newline = false
trim_trailing_whitespace = false

# Font files
[*.{ttf,otf,woff,woff2,eot}]
insert_final_newline = false
trim_trailing_whitespace = false

# Audio/Video files
[*.{mp3,mp4,avi,mkv,flv,webm,ogg,wav}]
insert_final_newline = false
trim_trailing_whitespace = false

# Archive files
[*.{tar,gz,bz2,xz,7z,rar,zip}]
insert_final_newline = false
trim_trailing_whitespace = false