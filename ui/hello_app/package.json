{
  "name": "hello-polymera-app",
  "version": "0.1.0",
  "description": "Minimal TypeScript React app for Polymera OS UI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts src/**/*.tsx",
    "format": "prettier --write src/**/*.ts src/**/*.tsx",
    "clean": "rm -rf dist",
    "bazel:build": "bazel build //ui/hello_app:hello_app",
    "bazel:test": "bazel test //ui/hello_app:all_tests",
    "bazel:clean": "bazel clean --expunge"
  },
  "keywords": [
    "polymera",
    "os",
    "ui",
    "typescript",
    "react",
    "bazel"
  ],
  "author": "Polymera OS Team",
  "license": "MIT",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/polymera-os/polymera-os.git",
    "directory": "ui/hello_app"
  },
  "bugs": {
    "url": "https://github.com/polymera-os/polymera-os/issues"
  },
  "homepage": "https://github.com/polymera-os/polymera-os#readme"
}
