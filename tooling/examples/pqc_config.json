{
  "enable_pqc": true,
  "pqc_algorithms": [
    "Kyber512",
    "Dilithium2"
  ],
  "hybrid_mode": true,
  "classical_algorithms": [
    "ECDHE-RSA-AES256-GCM-SHA384",
    "ECDHE-ECDSA-AES256-GCM-SHA384"
  ],
  "key_management": {
    "key_rotation_interval_days": 90,
    "backup_keys": true,
    "key_storage": "hardware_security_module",
    "key_escrow": false
  },
  "performance_settings": {
    "precompute_keys": true,
    "cache_keys": true,
    "parallel_operations": true,
    "optimize_for_throughput": true
  },
  "security_settings": {
    "forward_secrecy": true,
    "perfect_forward_secrecy": true,
    "key_compromise_protection": true,
    "side_channel_protection": true
  },
  "compliance": {
    "nist_standards": true,
    "fips_140_2": true,
    "common_criteria": true,
    "sox_compliance": true
  }
}
