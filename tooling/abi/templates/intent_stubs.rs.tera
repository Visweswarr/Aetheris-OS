#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_intent_header_default() {
        let header = IntentHeaderV1::default();
        assert_eq!(header.version, 1);
        assert_eq!(header.lane, 0);
        assert_eq!(header.intent_id, 0);
    }
    
    #[test]
    fn test_create_intent_header() {
        let header = create_intent_header(
            IntentLane::HIGH,
            12345,
            0,
            0x42,
            5000,
            100,
            50,
            25,
            10,
        );
        
        assert_eq!(header.version, 1);
        assert_eq!(header.lane, 1);
        assert_eq!(header.intent_id, 12345);
        assert_eq!(header.scope_flags, 0x42);
        assert_eq!(header.ttl_ms, 5000);
    }
    
    #[test]
    fn test_create_poll_filter() {
        let filter = create_poll_filter(0x07, 1000, 50, 0xFF);
        
        assert_eq!(filter.lane_mask, 0x07);
        assert_eq!(filter.since_ts, 1000);
        assert_eq!(filter.max_items, 50);
        assert_eq!(filter.state_mask, 0xFF);
    }
