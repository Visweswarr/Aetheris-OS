#[cfg(test)]
mod tests {
    use super::*;
    
    #[test]
    fn test_error_code() {
        let success = ErrorCode::new(0);
        let error = ErrorCode::new(1);
        
        assert!(success.is_success());
        assert!(!success.is_error());
        assert!(!error.is_success());
        assert!(error.is_error());
        
        assert_eq!(success.raw(), 0);
        assert_eq!(error.raw(), 1);
    }
    
    #[test]
    fn test_error_code_conversion() {
        let code = ErrorCode::from(42);
        assert_eq!(i32::from(code), 42);
        
        let code = ErrorCode::new(99);
        assert_eq!(code.raw(), 99);
    }
    
    #[test]
