/// Map Rust types to system call argument types
fn map_rust_type(type_name: &str) -> &'static str {
    match type_name {
        "u32" => "u32",
        "u64" => "u64",
        "usize" => "usize",
        "i32" => "i32",
        "i64" => "i64",
        "isize" => "isize",
        "*const u8" => "*const u8",
        "*mut u8" => "*mut u8",
        "*const c_void" => "*const c_void",
        "*mut c_void" => "*mut c_void",
        "!never" => "!",
        _ => "u64", // Default to u64 for unknown types
    }
}

/// Map Rust return types
fn map_rust_return_type(type_name: &str) -> &'static str {
    match type_name {
        "i32" => "Result<i32, ErrorCode>",
        "u64" => "u64",
        "*mut u8" => "Result<*mut u8, ErrorCode>",
        "!never" => "!",
        _ => "Result<i32, ErrorCode>", // Default to Result<i32, ErrorCode>
    }
}

/// Generate system call invocation code
fn generate_syscall_invocation(syscall: &crate::model::Syscall) -> String {
    let mut args = vec![];
    
    for (i, arg) in syscall.args.iter().enumerate() {
        let arg_value = match arg.type_name.as_str() {
            "u32" | "u64" | "usize" | "i32" | "i64" | "isize" => arg.name.clone(),
            "*const u8" | "*mut u8" | "*const c_void" | "*mut c_void" => format!("{} as u64", arg.name),
            _ => format!("{} as u64", arg.name),
        };
        args.push(arg_value);
    }
    
    // Pad with zeros to ensure 6 arguments
    while args.len() < 6 {
        args.push("0".to_string());
    }
    
    format!(
        "raw_syscall({}, {}, {}, {}, {}, {}, {})",
        syscall.id,
        args[0], args[1], args[2], args[3], args[4], args[5]
    )
}

/// Error code type
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub struct ErrorCode(i32);

impl ErrorCode {
    /// Create a new error code
    pub const fn new(code: i32) -> Self {
        Self(code)
    }
    
    /// Get the raw error code value
    pub const fn raw(self) -> i32 {
        self.0
    }
    
    /// Check if this is a success code
    pub const fn is_success(self) -> bool {
        self.0 == 0
    }
    
    /// Check if this is an error code
    pub const fn is_error(self) -> bool {
        self.0 != 0
    }
}

impl From<i32> for ErrorCode {
    fn from(code: i32) -> Self {
        Self(code)
    }
}

impl From<ErrorCode> for i32 {
    fn from(err: ErrorCode) -> Self {
        err.raw()
    }
}

impl core::fmt::Display for ErrorCode {
    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
        write!(f, "ErrorCode({})", self.0)
    }
}

