}

/// Get syscall category from ID
pub fn get_syscall_category(id: u32) -> Option<&'static str> {
    use ranges::*;
    
    match id {
        TASK_MANAGEMENT_START..=TASK_MANAGEMENT_END => Some("task_management"),
        IPC_START..=IPC_END => Some("ipc"),
        CAPABILITY_START..=CAPABILITY_END => Some("capability"),
        SYSTEM_INFO_START..=SYSTEM_INFO_END => Some("system_info"),
        MEMORY_MANAGEMENT_START..=MEMORY_MANAGEMENT_END => Some("memory_management"),
        RESERVED_1_START..=RESERVED_1_END => Some("reserved_1"),
        RESERVED_2_START..=RESERVED_2_END => Some("reserved_2"),
        _ => None,
    }
}

/// Check if a syscall ID is reserved for future use
pub fn is_syscall_reserved(id: u32) -> bool {
    use ranges::*;
    
    is_syscall_in_range(id, RESERVED_1_START, RESERVED_1_END) ||
    is_syscall_in_range(id, RESERVED_2_START, RESERVED_2_END)
}

/// Check if a syscall ID is valid (not reserved)
pub fn is_valid_syscall_id(id: u32) -> bool {
    !is_syscall_reserved(id) && id <= MAX_SYSCALL_ID
}

