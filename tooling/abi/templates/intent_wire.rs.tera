    #[test]
    fn test_intent_header_validation() {
        let mut header = IntentHeaderV1 {
            version: 1,
            lane: 0,
            reserved: 0,
            intent_id: 1,
            parent_id: 0,
            scope_flags: 0,
            ttl_ms: 1000,
            text_len: 100,
            plan_len: 0,
            preview_len: 0,
            whylog_len: 0,
            hash: [0; 32],
            purpose_hash: [0; 32],
        };
        
        assert!(header.is_valid());
        
        header.version = 2;
        assert!(!header.is_valid());
        
        header.version = 1;
        header.ttl_ms = 0;
        assert!(!header.is_valid());
    }
    
    #[test]
    fn test_serialization() {
        let header = IntentHeaderV1 {
            version: 1,
            lane: 1,
            reserved: 0,
            intent_id: 12345,
            parent_id: 0,
            scope_flags: 0x42,
            ttl_ms: 5000,
            text_len: 100,
            plan_len: 50,
            preview_len: 25,
            whylog_len: 10,
            hash: [1; 32],
            purpose_hash: [2; 32],
        };
        
        let mut buf = [0u8; IntentHeaderV1::SIZE];
        let written = header.serialize(&mut buf).unwrap();
        assert_eq!(written, IntentHeaderV1::SIZE);
        
        let deserialized = IntentHeaderV1::deserialize(&buf).unwrap();
        assert_eq!(header.version, deserialized.version);
        assert_eq!(header.intent_id, deserialized.intent_id);
        assert_eq!(header.scope_flags, deserialized.scope_flags);
    }
